    # Общее тело, разделяемое всеми server{}-блоками, которые собирает
    # NginxConfigService.render() (backend/src/system/nginx-config.service.ts) в
    # nginx/generated/default.conf по текущим настройкам (домен/HTTP/HTTPS) — сам этот
    # файл НЕ используется nginx напрямую, только как источник для рендера. Редактировать
    # локации нужно здесь; server{}/listen/ssl_certificate добавляет сервис.

    # 5m по умолчанию слишком мало для загрузки бэкапа БД на восстановление
    # (POST /system/restore, backend/src/system/) — дампы легко больше по размеру.
    client_max_body_size 200m;

    # 127.0.0.11 — встроенный DNS докера внутри compose-сети. Без этого nginx резолвит
    # "backend"/"frontend" ОДИН РАЗ при старте воркера и держит IP в памяти до перезапуска
    # nginx — при пересоздании backend/frontend (обновление по кнопке, см.
    # system/update.service.ts) они получают НОВЫЙ IP, и nginx продолжал бы стучаться в
    # старый (502 Connection refused) до ручного restart. С resolver + переменной в
    # proxy_pass nginx переспрашивает DNS заново по истечении valid — не нужно перезапускать
    # nginx при каждом обновлении backend/frontend.
    #
    # ВАЖНО: когда host:port в proxy_pass задан ПЕРЕМЕННОЙ (а не литералом), nginx
    # ПЕРЕСТАЁТ САМ вырезать префикс location из URI (это документированное поведение —
    # автоматическая замена префикса работает только для proxy_pass со статическим URI).
    # Без rewrite ниже "/api/auth/login" ушёл бы на backend как буквально "/" — поймано
    # вживую: сломало вообще все /api/-запросы с момента, когда nginx впервые пересоздался
    # с этим конфигом (реальный инцидент). rewrite ... break вырезает префикс ЯВНО ДО
    # proxy_pass, а сам proxy_pass — без URI-части, чтобы просто передать то, что после
    # rewrite осталось в $uri.
    resolver 127.0.0.11 valid=10s;

    location /api/ {
        # set ДО rewrite ... break — break останавливает выполнение остальных директив
        # rewrite-модуля (включая set) в этом location, если поставить его раньше:
        # переменная осталась бы неинициализированной ("uninitialized variable", поймано
        # вживую при разворачивании этого самого фикса).
        set $backend_upstream backend:3000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Установка/детект протокола, ребут и т.п. идут по SSH и могут занимать дольше
        # дефолтных 60с (особенно AmneziaWG: add-apt-repository + apt-get update + install
        # из PPA) — без этого nginx обрывал соединение раньше, чем backend успевал
        # закончить операцию. Backend при этом доводил операцию до конца и сохранял
        # правильный результат в БД — но клиент уже получил обрыв соединения и показывал
        # ошибку, хотя по факту всё установилось (поймано вживую: "Не удалось установить
        # протокол" в UI при реально успешной установке AmneziaWG).
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Дашборд (backend/src/dashboard/) держит соединение по WebSocket через socket.io —
    # его handshake всегда идёт по этому пути (namespace задаётся уже поверх соединения,
    # отдельного nginx-роута под каждый namespace не нужно). Без Upgrade/Connection-
    # заголовков nginx проксировал бы это как обычный HTTP и апгрейд до WebSocket не
    # прошёл бы. Префикс /socket.io/ здесь НЕ вырезаем — backend ждёт его в неизменном виде
    # (это его собственный путь по умолчанию, не наш nginx-алиас), поэтому proxy_pass без
    # URI-части — передать оригинальный $uri как есть.
    location /socket.io/ {
        set $backend_upstream backend:3000;
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location / {
        set $frontend_upstream frontend:80;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
